# Arkiv — get a key at https://hub.arkiv.network/access-keys
ARKIV_ACCESS_KEY=ark_live_xxxxxxxxxxxxxxxxxxxxxxxx
# Dedicated development EOA. Testnet only. Never a personal wallet.
DEPLOYER_PRIVATE_KEY=0x...
# 0G Router — https://pc.0g.ai  (mainnet key, starts sk-)
ZEROG_API_KEY=sk-...
ZEROG_BASE_URL=https://router-api.0g.ai/v1
# Sepolia
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Swarm — a postage batch is required to upload; there is no public upload gateway.
# Ask Swarm/Arkiv for a batch id, or buy one on your own Bee node.
SWARM_BEE_URL=http://localhost:1633
SWARM_POSTAGE_BATCH=
SWARM_GATEWAY=https://gateway.ethswarm.org
# Master secret for per-case encryption keys. Never commit a real one.
WASP_MASTER_KEY=

# GitHub — unauthenticated is 60 requests/hour and the Projects tab will
# rate-limit during a demo. A token lifts it to 5,000/hour. Any classic or
# fine-grained token with PUBLIC READ ONLY is enough; no scopes are needed.
#   gh auth token            (if you use the GitHub CLI)
GITHUB_TOKEN=
